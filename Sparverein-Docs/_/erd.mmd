erDiagram
    BOOK zero or one -- zero or one USER : has
    BOOK one -- zero or many TRANSACTION : has
    USER one -- zero or many TRANSACTION : has

    BOOK {
        int book_id PK
        varchar title
        varchar author
        boolean isAvailable
    }

    USER {
        int person_id PK
        varchar firstname
        varchar lastname
        byteArray image
        byte isActive
    }

    TRANSACTION {
        int transaction_id PK
        int transaction_type
        int book_id FK
        int user_id FK
        varchar comment
        timestamp datetime
    }
    
